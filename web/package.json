{
  "name": "prooflab-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build --base=./",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write index.html src tests package.json",
    "format:check": "prettier --check index.html src tests package.json"
  },
  "dependencies": {
    "katex": "0.16.22"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "vite": "7.1.7"
  }
}
